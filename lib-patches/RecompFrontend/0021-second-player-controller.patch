+static std::atomic<SDL_JoystickID> second_player_controller = -1;
+
+void recompinput::set_second_player_controller(SDL_JoystickID joystick_id) {
+    second_player_controller.store(joystick_id);
+}
+
+SDL_JoystickID recompinput::get_second_player_controller() {
+    return second_player_controller.load();
+}
+
+static SDL_JoystickID joystick_id_of(SDL_GameController* controller) {
+    return SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controller));
+}
+
+// Single player mode: whether a player reads a controller (see set_second_player_controller).
+// Called with controllers_mutex held.
+static bool single_player_reads(int controller_num, SDL_JoystickID joystick_id) {
+    const SDL_JoystickID second = second_player_controller.load();
+    const bool is_second = second >= 0 && joystick_id == second;
+    return controller_num == 0 ? !is_second : (controller_num == 1 && is_second);
+}
+
+SDL_JoystickID recompinput::get_controller_pressing_button(SDL_JoystickID except) {
+    std::lock_guard lock{ InputState.controllers_mutex };
+    for (SDL_GameController* controller : InputState.detected_controllers) {
+        const SDL_JoystickID id = joystick_id_of(controller);
+        if (id == except) {
+            continue;
+        }
+        for (int button = 0; button < SDL_CONTROLLER_BUTTON_MAX; button++) {
+            if (SDL_GameControllerGetButton(controller, (SDL_GameControllerButton)button)) {
+                return id;
+            }
+        }
+    }
+    return -1;
+}
+
+bool recompinput::is_controller_connected(SDL_JoystickID joystick_id) {
+    std::lock_guard lock{ InputState.controllers_mutex };
+    for (SDL_GameController* controller : InputState.detected_controllers) {
+        if (joystick_id_of(controller) == joystick_id) {
+            return true;
+        }
+    }
+    return false;
+}
+
+size_t recompinput::get_connected_controller_count() {
+    std::lock_guard lock{ InputState.controllers_mutex };
+    return InputState.detected_controllers.size();
+}
